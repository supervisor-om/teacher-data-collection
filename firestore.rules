rules_version = '2';

/* ====================================================================
 *  قواعد أمان Firestore — مشروع بيانات معلمي الرياضة المدرسية
 *
 *  المرحلة ١ (هذه): تُغلق ما يمكن إغلاقه بلا مصادقة.
 *    • تمنع إنشاء أي مجموعة خارج المجموعتين المعروفتين
 *    • تتحقّق من شكل الوثيقة وحجمها فتمنع الحشو والعبث
 *    • تمنع تغيير نوع المدرسة بعد الإنشاء
 *
 *  ما لا تستطيع هذه المرحلة فعله، ويجب أن يكون واضحاً:
 *    القراءة والحذف يبقيان مفتوحين. العارض يعمل بلا حساب، فأي قاعدة
 *    تسمح له بالقراءة تسمح بها لأي أحد. الإصلاح الحقيقي للسرّية
 *    ولمنع الحذف هو المرحلة ٢ (Firebase Authentication) في آخر الملف.
 * ==================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------- بيانات المعلمين -- */
    match /teachers/{docId} {

      function data()  { return request.resource.data; }
      function isStr(f, maxLen) {
        return !(f in data()) || (data()[f] is string && data()[f].size() <= maxLen);
      }
      function wellFormed() {
        return data().keys().size() <= 40
            && data().keys().size() >= 3
            && data()['نوع المدرسة'] in ['حكومية', 'خاصة']
            && data()['اسم المعلم'] is string
            && data()['اسم المعلم'].size() > 1
            && data()['اسم المعلم'].size() <= 120
            && isStr('المدرسة', 150)
            && isStr('المشرف', 80)
            && isStr('الهاتف', 30)
            && isStr('الرقم المدني', 30)
            && isStr('البريد الالكتروني', 120);
      }

      allow create: if wellFormed();

      /* التعديل لا يغيّر نوع المدرسة — فصل البيانات يقوم عليه */
      allow update: if wellFormed()
                    && data()['نوع المدرسة'] == resource.data['نوع المدرسة'];

      /* مفتوحان حتى تُضاف المصادقة — انظر المرحلة ٢ */
      allow read:   if true;
      allow delete: if true;
    }

    /* ------------------------------------------ رموز دخول المشرفين -- */
    match /supervisor_codes/{supId} {
      /* بصمة SHA-256 فقط: 64 محرفاً ست عشرياً. لا يُقبل نصّ آخر،
         فلا تُستعمل المجموعة لتخزين أي شيء سوى بصمة. */
      function validHash() {
        return request.resource.data.keys().hasOnly(['hash', 'updatedAt'])
            && request.resource.data.hash is string
            && request.resource.data.hash.matches('^[0-9a-f]{64}$');
      }
      allow read: if true;                    /* البوّابة تحتاجها قبل الدخول */
      allow create, update: if validHash();
      /* لا delete: حذف الرمز يعيد المشرف إلى البصمة المكتوبة في الملف
         بلا علمه، ولا حاجة إليه من الواجهة. */
    }

    /* ------------------------------------ قائمة المدارس المعروفة -- */
    /* وثيقةٌ واحدة تقرؤها الاستمارة لتقترح أسماء المدارس، بدل قراءة
       مجموعة المعلّمين كاملةً في كل فتحة — وهي التي أنفدت الحصّة
       اليومية فتوقّف الموقع. لا تحمل بيانات معلّمين، فقراءتها لا
       تكشف شيئاً؛ والكتابة مقيَّدة بشكلها فلا تُستعمل مخزناً. */
    match /meta/schools {
      function ok() {
        return request.resource.data.keys().hasOnly(['حكومية', 'خاصة', 'updatedAt'])
            && (!('حكومية' in request.resource.data)
                || (request.resource.data['حكومية'] is list
                    && request.resource.data['حكومية'].size() <= 500))
            && (!('خاصة' in request.resource.data)
                || (request.resource.data['خاصة'] is list
                    && request.resource.data['خاصة'].size() <= 500));
      }
      allow read: if true;
      allow create, update: if ok();
      allow delete: if false;
    }

    /* ------------------------------- دليل الاستمارات السابقة -- */
    /* بصمةُ المعرِّف ← رقم السجلّ. لا يحمل اسماً ولا رقماً مدنياً ولا
       هاتفاً، والبصمة لا تُردّ إلى أصلها. تقرؤه الاستمارةُ العامّة
       لتُحدّث استمارةَ المرسِل بدل تسجيل نسخةٍ ثانية — وهو ما يُغني
       عن قراءة بيانات المعلّمين، فتُغلق تلك خلف المصادقة.
       والقيم أرقامُ سجلّاتٍ فقط: نصوصٌ قصيرة لا شيء غيرها. */
    match /meta/index {
      allow read: if true;
      allow create, update: if request.resource.data.size() <= 5000;
      allow delete: if false;
    }

    /* ------------------------------------------------ ما عدا ذلك -- */
    /* يمنع استعمال قاعدة البيانات مخزناً مجانياً لأي محتوى غريب */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/* ====================================================================
 *  المرحلة ٢ — الإصلاح الحقيقي (تحتاج تعديلاً في الكود)
 *
 *  بعد تفعيل Firebase Authentication وإنشاء حساب لكل مشرف، استبدل
 *  السطرين المفتوحين في teachers بما يلي:
 *
 *      allow read:   if request.auth != null;
 *      allow delete: if request.auth != null;
 *
 *  وتبقى allow create مفتوحة كي تعمل استمارة المعلمين العامة بلا حساب.
 *  عندها فقط تصير البيانات سرّية فعلاً، ويعجز غير المسجَّل عن حذفها.
 * ==================================================================== */
